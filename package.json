{
  "name": "@onlyonworld/axios-cache",
  "version": "0.1.0",
  "description": "劫持 axios 请求，将响应缓存于 IndexedDB，支持 TTL、发版清缓存、多账号隔离与静默刷新",
  "type": "module",
  "license": "MIT",
  "author": "onlyonworld",
  "homepage": "https://github.com/onlyonworld/cache-request#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlyonworld/cache-request.git"
  },
  "bugs": {
    "url": "https://github.com/onlyonworld/cache-request/issues"
  },
  "keywords": [
    "axios",
    "cache",
    "indexeddb",
    "localforage",
    "adapter",
    "request",
    "offline"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "dependencies": {
    "localforage": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "axios": "^1.21.0",
    "fake-indexeddb": "^6.2.7",
    "tsup": "^8.5.1",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
